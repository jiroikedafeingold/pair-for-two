      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand gewinnt, wird die ganze Zählung des Spiels Punkt für Punkt wiederholt, bevor der Siegesbildschirm erscheint. Du kannst sie von dort aus auch jederzeit erneut ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien gana, repasa toda la puntuación de la partida punto a punto antes de mostrar la pantalla de victoria. También puedes verla cuando quieras desde esa pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu'un gagne, revoit tout le comptage de la partie, point par point, avant l'écran de victoire. Tu peux aussi le revoir à tout moment depuis cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando qualcuno vince, ripercorre tutto il conteggio della partita, punto per punto, prima della schermata di vittoria. Puoi rivederlo quando vuoi da quella schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが勝ったとき、勝利画面の前に対戦全体の得点を1つずつ振り返ります。勝利画面からいつでも再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 이기면 승리 화면 전에 게임 전체의 점수를 한 점씩 되짚습니다. 승리 화면에서 언제든 다시 볼 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém vence, revê toda a contagem da partida, ponto por ponto, antes da tela de vitória. Você também pode revê-la quando quiser nessa tela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri kazandığında, kazanma ekranından önce oyunun tüm puanlarını tek tek gösterir. Bu ekrandan istediğin zaman yeniden izleyebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人获胜时，先一分一分地回看整局得分，再显示胜利画面。你也可以随时从胜利画面重看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人獲勝時，先一分一分地回看整局得分，再顯示勝利畫面。你也可以隨時從勝利畫面重看。"
          }
        }
      }
    },
