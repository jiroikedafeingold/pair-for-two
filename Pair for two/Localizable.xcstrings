    "Couldn't find %@ in Game Center. They may need to invite you instead — or pick them from your friends and recent players.": {
      "comment": "%@ is the other player's name, or a stand-in for it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde im Game Center nicht gefunden. Vielleicht muss die Person dich einladen – oder du wählst sie aus deinen Freunden und letzten Mitspielern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado a %@ en Game Center. Puede que tenga que invitarte él, o puedes elegirlo entre tus amigos y jugadores recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver %@ dans Game Center. C'est peut-être à lui de t'inviter, ou choisis-le parmi tes amis et joueurs récents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è stato trovato in Game Center. Forse deve invitarti lui, oppure scegli il suo nome fra amici e giocatori recenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Centerで %@ が見つかりませんでした。相手から招待してもらうか、友達・最近のプレイヤーから選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center에서 %@ 님을 찾지 못했습니다. 상대가 당신을 초대해야 할 수도 있고, 친구나 최근 플레이어 목록에서 선택할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos %@ no Game Center. Talvez a pessoa precise convidar você — ou escolha-a entre seus amigos e jogadores recentes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Game Center'da bulunamadı. Onun seni davet etmesi gerekebilir; ya da arkadaşların ve son oyuncular arasından seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在Game Center里没找到 %@。可能需要对方来邀请你，或者从好友和最近的玩家里选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在Game Center找不到 %@。可能需要對方邀請你，或從好友與最近的玩家中選擇。"
          }
        }
      }
    },
    "Couldn't reach Game Center. Check your internet connection and try again.": {
      "comment": "Error shown when Game Center is unreachable",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ist nicht erreichbar. Prüfe deine Internetverbindung und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con Game Center. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Game Center. Vérifie ta connexion internet et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center non è raggiungibile. Controlla la connessione e riprova."
