    "Applies to the whole game — either player can change it.": {
      "comment": "A description of the scoring mode setting.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für das ganze Spiel – beide Spieler können es ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a toda la partida; cualquiera de los dos puede cambiarlo."
          }
