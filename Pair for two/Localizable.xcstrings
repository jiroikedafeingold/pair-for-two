    },
    "They'll get a Game Center invitation — they need to accept it to pick the game up where you left off.": {
      "comment": "Explains what the other player has to do",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person bekommt eine Game-Center-Einladung und muss sie annehmen, damit es dort weitergeht, wo ihr aufgehört habt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirá una invitación de Game Center y tendrá que aceptarla para retomar la partida donde la dejasteis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il recevra une invitation Game Center et devra l'accepter pour reprendre la partie là où vous l'avez laissée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverà un invito di Game Center e dovrà accettarlo per riprendere la partita da dove l'avete lasciata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手にGame Centerの招待が届きます。受け入れてもらえば、中断した場面から続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대에게 Game Center 초대가 갑니다. 상대가 수락하면 중단된 지점부터 이어서 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa vai receber um convite do Game Center e precisa aceitá-lo para retomar a partida de onde vocês pararam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona bir Game Center daveti gider; kaldığınız yerden devam etmek için kabul etmesi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会收到Game Center邀请，接受后才能从中断处继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方會收到Game Center邀請，接受後才能從中斷處繼續。"
          }
        }
      }
    },
    "They'll get a Game Center invite — keep this screen open until they join.": {
      "comment": "A description of the invitation process.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person bekommt eine Game-Center-Einladung – lass diesen Bildschirm offen, bis sie beitritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirá una invitación de Game Center; deja esta pantalla abierta hasta que se una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il recevra une invitation Game Center : garde cet écran ouvert jusqu'à ce qu'il rejoigne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverà un invito di Game Center: tieni aperta questa schermata finché non entra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手にGame Centerの招待が届きます。参加するまでこの画面を開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대에게 Game Center 초대가 갑니다. 상대가 참가할 때까지 이 화면을 열어 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa vai receber um convite do Game Center — mantenha esta tela aberta até ela entrar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona bir Game Center daveti gider; katılana kadar bu ekranı açık tut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会收到Game Center邀请，请保持此界面开启，直到对方加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
