    "Turns to face each player in turn. Double tap to turn it now.": {
      "comment": "A hint for the user on the accessibility screen.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreht sich abwechselnd zu jedem Spieler. Doppeltippen, um sofort zu drehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira hacia cada jugador por turnos. Toca dos veces para girarlo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pivote vers chaque joueur à tour de rôle. Touche deux fois pour le faire pivoter maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota verso ogni giocatore a turno. Tocca due volte per ruotarlo subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人の方を交互に向きます。ダブルタップするとすぐ回ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 플레이어를 번갈아 향합니다. 두 번 누르면 바로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira para cada jogador, um por vez. Toque duas vezes para girar agora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırayla her oyuncuya döner. Hemen döndürmek için iki kez dokun."
