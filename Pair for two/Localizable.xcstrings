    },
    "This clears both scores.": {
      "comment": "The text in a confirmation dialog that asks whether to start a new game.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden beide Punktestände zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto pone a cero las dos puntuaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remet les deux scores à zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo azzera i due punteggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両者のスコアが0に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽 점수가 0으로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso zera as duas pontuações."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, iki puanı da sıfırlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会把双方分数归零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會把雙方分數歸零。"
          }
        }
      }
    },
    "This ends the game for both players.": {
