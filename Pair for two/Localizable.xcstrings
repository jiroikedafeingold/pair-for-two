      }
    },
    "Scoreboard games aren't added to your stats — the app never sees the hands, so there'd be nothing to record beyond the result.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele auf der Anzeigetafel kommen nicht in die Statistik – die App sieht die Blätter nie, es gäbe außer dem Ergebnis nichts festzuhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas del marcador no se añaden a tus estadísticas: la app no ve las manos, así que no habría nada que registrar aparte del resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parties au tableau de score ne comptent pas dans tes statistiques : l'app ne voit pas les mains, il n'y aurait donc rien à enregistrer à part le résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partite col tabellone non entrano nelle statistiche: l'app non vede le mani, quindi non ci sarebbe nulla da registrare oltre al risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコアボードの対戦は記録に追加されません。アプリは手札を見ないため、結果以外に残せるものがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수판 게임은 기록에 추가되지 않습니다. 앱이 핸드를 보지 못하므로 결과 외에 남길 것이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partidas no marcador não entram nas estatísticas — o app não vê as mãos, então não haveria nada a registrar além do resultado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skor tahtası oyunları istatistiklere eklenmez: uygulama elleri görmediği için sonuç dışında kaydedecek bir şey olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记分板的对局不会计入统计：应用看不到手牌，除了结果之外没有可记录的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計分板的對局不會計入統計：App看不到手牌，除了結果之外沒有可記錄的內容。"
          }
        }
      }
    },
    "Scored automatically": {
      "comment": "The app is keeping score, so there is nothing to add",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch gezählt"
          }
        },
        "es": {
          "stringUnit": {
