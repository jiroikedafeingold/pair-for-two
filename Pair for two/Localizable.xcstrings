          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le **?** du tableau à tout moment pour rouvrir ce guide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il **?** sul tabellone quando vuoi per riaprire questa guida."
