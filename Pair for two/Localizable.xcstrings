    "Pick the %@ up to read the score and it turns the right way up for whoever is holding it. Flat on the table it goes back to taking turns.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el %@ para leer el marcador y girará del derecho para quien lo tenga en la mano. Apoyado en la mesa, vuelve a alternar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends le %@ en main pour lire le score : il pivote dans le bon sens pour celui qui le tient. Reposé à plat, il recommence à alterner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm das %@ in die Hand, um den Punktestand zu lesen — er dreht sich richtig herum für den, der es hält. Flach auf dem Tisch wechselt er wieder ab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を持ち上げてスコアを見ると、持っている人から見て正しい向きになります。テーブルに平らに置くと、また交互に向きを変えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拿起%@看分数时，它会朝着拿着它的人转到正确方向。放平在桌上后，又会轮流转向两人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拿起%@看分數時，它會朝著拿著它的人轉到正確方向。平放在桌上後，又會輪流轉向兩人。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue o %@ para ler a pontuação e ela gira na posição certa para quem está segurando. Apoiado na mesa, volta a alternar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi in mano il %@ per leggere il punteggio e si gira nel verso giusto per chi lo tiene. Appoggiato sul tavolo, torna ad alternarsi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 들어 점수를 보면 들고 있는 사람 쪽으로 바르게 돌아갑니다. 테이블에 평평하게 두면 다시 번갈아 돌아갑니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanı okumak için %@ cihazını eline al; tutan kişiye göre doğru yöne döner. Masaya düz bıraktığında yine sırayla döner."
          }
        }
      }
    },
    "Pick up **%@** — both phones tap this.": {
