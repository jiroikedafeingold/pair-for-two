    "Holds the slider value until you tap the +N button, instead of adding it the moment you let go.": {
      "comment": "The description of the scoring slider.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Wert des Schiebers, bis du auf +N tippst, statt ihn beim Loslassen sofort zu addieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
