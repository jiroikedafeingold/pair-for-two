    "Playing against an Android phone? Put both devices on the same Wi-Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst gegen ein Android-Gerät? Bringt beide Geräte ins gleiche WLAN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Juegas contra un teléfono Android? Pon los dos dispositivos en la misma red Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu joues contre un téléphone Android ? Mets les deux appareils sur le même Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giochi contro un dispositivo Android? Mettete entrambi sulla stessa rete Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android端末と対戦する場合は、2台を同じWi-Fiに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안드로이드 기기와 하나요? 두 기기를 같은 Wi-Fi에 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogando contra um Android? Coloque os dois aparelhos na mesma rede Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android cihaza karşı mı oynuyorsun? İki cihazı da aynı Wi-Fi'a bağla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对手用安卓设备？把两台设备连到同一个Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對手用Android裝置？把兩台裝置連到同一個Wi-Fi。"
          }
        }
      }
    },
    "Playing as **%@**": {
