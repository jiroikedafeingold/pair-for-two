    "We kept trying to get them back, but they didn't rejoin. This game can't be picked up from here.": {
      "comment": "Shown when an online opponent never came back",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben weiter versucht, die Person zurückzuholen, aber sie ist nicht wiedergekommen. Dieses Spiel lässt sich nicht mehr fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos seguido intentando que volviera, pero no lo ha hecho. Esta partida ya no se puede retomar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On a essayé de le faire revenir, sans succès. Cette partie ne peut plus être reprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo continuato a provare a farlo rientrare, ma non è tornato. Questa partita non può più essere ripresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手を戻そうと試み続けましたが、戻ってきませんでした。この対戦はここから再開できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대를 계속 불러 봤지만 돌아오지 않았습니다. 이 게임은 더 이상 이어서 할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentamos várias vezes trazer a pessoa de volta, mas ela não voltou. Esta partida não pode mais ser retomada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu geri getirmeye çalıştık ama dönmedi. Bu oyun buradan devam ettirilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们一直尝试让对方回来，但对方没有重新加入。这局无法继续了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們持續嘗試讓對方回來，但對方沒有重新加入。這局無法繼續了。"
          }
        }
      }
    },
