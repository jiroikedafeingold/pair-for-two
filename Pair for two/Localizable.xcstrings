    "Make sure the other phone also tapped **Rejoin game**.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass das andere Gerät ebenfalls **Spiel fortsetzen** getippt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que el otro teléfono también ha pulsado **Volver a la partida**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que l'autre téléphone a aussi touché **Reprendre la partie**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che anche l'altro dispositivo abbia toccato **Torna alla partita**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の端末でも**対戦に戻る**をタップしたか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기에서도 **게임으로 돌아가기**를 눌렀는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que o outro aparelho também tocou em **Voltar à partida**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazın da **Oyuna dön**'e dokunduğundan emin ol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认对方的设备也点了**回到对局**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認對方的裝置也點了**回到對局**。"
          }
        }
      }
    },
