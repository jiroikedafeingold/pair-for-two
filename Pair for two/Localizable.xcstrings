    "For an Android phone, both devices must be on the same Wi-Fi network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einem Android-Gerät müssen beide Geräte im gleichen WLAN sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un teléfono Android, los dos dispositivos tienen que estar en la misma red Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un téléphone Android, les deux appareils doivent être sur le même réseau Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un dispositivo Android, entrambi devono essere sulla stessa rete Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android端末の場合は、2台が同じWi-Fiネットワークに接続されている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안드로이드 기기와 할 때는 두 기기가 같은 Wi-Fi 네트워크에 있어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um aparelho Android, os dois precisam estar na mesma rede Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android cihazla oynarken iki cihaz da aynı Wi-Fi ağında olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果对方是安卓设备，两台必须连在同一个Wi-Fi网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若對方是Android裝置，兩台必須連在同一個Wi-Fi網路。"
          }
        }
      }
    },
