{
  "sourceLanguage": "en",
  "strings": {
    "%@ %lld to %lld against %@%@. %lld hands, %@.": {
      "comment": "VoiceOver summary of one past game",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld zu %lld gegen %@%@. %lld Blätter, %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld to %3$lld against %4$@%5$@. %6$lld hands, %7$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld a %lld contra %@%@. %lld manos, %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld à %lld contre %@%@. %lld mains, %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld a %lld contro %@%@. %lld mani, %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld対%lld、相手は%@%@。%lldハンド、%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld대 %lld, 상대 %@%@. %lld핸드, %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld a %lld contra %@%@. %lld mãos, %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld-%lld, rakip %@%@. %lld el, %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld比%lld，对手%@%@。%lld手牌，%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld比%lld，對手%@%@。%lld手牌，%@。"
          }
        }
      }
    },
