    "Two phones in the same room, a hand each. No internet or account — leave Wi-Fi on and it pairs faster.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Geräte im gleichen Raum, jeder ein Blatt. Ohne Internet und Konto – lass das WLAN an, dann geht die Kopplung schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos teléfonos en la misma habitación, una mano cada uno. Sin internet ni cuentas: deja el Wi-Fi activado y se emparejan más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux téléphones dans la même pièce, une main chacun. Sans internet ni compte : laisse le Wi-Fi activé et l'appairage est plus rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due dispositivi nella stessa stanza, una mano per ciascuno. Senza internet né account: lascia il Wi-Fi attivo e l'abbinamento è più rapido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ部屋の2台で、手札は1人ずつ。インターネットもアカウントも不要です。Wi-Fiをオンにしておくと早くつながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 공간의 두 기기로, 각자 핸드를 가집니다. 인터넷도 계정도 필요 없습니다. Wi-Fi를 켜 두면 더 빨리 연결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois aparelhos na mesma sala, uma mão para cada. Sem internet nem conta — deixe o Wi-Fi ligado e o pareamento fica mais rápido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı odada iki cihaz, her oyuncuya bir el. İnternet ya da hesap gerekmez — Wi-Fi'ı açık bırakırsan daha hızlı eşleşir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个房间里的两台设备，各拿一手牌。无需联网或账号 — 保持Wi-Fi开启配对更快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個房間裡的兩台裝置，各拿一手牌。不需網路或帳號 — 保持Wi-Fi開啟配對更快。"
          }
        }
      }
    },
