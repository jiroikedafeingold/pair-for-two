<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<!-- MultipeerConnectivity (serviceType "pairfortwo") registers these two. -->
		<string>_pairfortwo._tcp</string>
		<string>_pairfortwo._udp</string>
		<!-- LANTransport: the cross-platform iOS<->Android path. Kept on its own type so its
		     browser never discovers a Multipeer advertisement. See PROTOCOL.md. -->
		<string>_pairfortwo-lan._tcp</string>
	</array>
	<!-- WiFiAwareTransport: iPhone 12 and later, paired once through the system sheet, then
	     connecting directly without discovery. Published by the host, subscribed by the guest. -->
	<key>WiFiAwareServices</key>
	<dict>
		<key>_pairfortwo-wa._tcp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
	</dict>
</dict>
</plist>
